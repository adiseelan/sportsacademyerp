# ------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ------------------------------------------------------------------

# Core
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Which settings module to load (config.settings.dev | config.settings.prod)
DJANGO_SETTINGS_MODULE=config.settings.dev

# Database — leave DATABASE_URL empty to use SQLite (dev default).
# Postgres example: postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# Security toggles (prod should be True; dev over http must be False)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# Email — OTP + notifications. Dev uses console backend (OTP prints to terminal).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SportsAcademy ERP <no-reply@sportsacademy.local>

# OTP policy
OTP_LENGTH=6
OTP_TTL_SECONDS=300          # OTP valid for 5 minutes
OTP_MAX_SENDS=5              # max OTP sends before cooldown
OTP_COOLDOWN_SECONDS=900     # 15 min wait after hitting the send limit
OTP_MAX_VERIFY_ATTEMPTS=5    # wrong-code tries before the code is burned
# TESTING ONLY: show the OTP on the login screen so a test team can log in
# without real email. NEVER leave True for a real launch.
OTP_SHOW_ON_SCREEN=False

# Optional provider keys (leave blank to use safe stub backends)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
WHATSAPP_FROM_NUMBER=
